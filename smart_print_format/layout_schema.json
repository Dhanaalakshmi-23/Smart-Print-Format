{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "smart_print_format/layout_schema.json",
	"title": "Smart Print Format layout",
	"description": "Shape of Smart Print Format.layout_json, as the designer frontend (frontend/src/utils/layout.js) builds it. validators.py checks layouts against this file; keep the two in sync.",
	"type": "object",
	"required": ["sections"],
	"additionalProperties": false,
	"properties": {
		"sections": {
			"type": "array",
			"maxItems": 200,
			"items": { "$ref": "#/$defs/section" }
		}
	},
	"$defs": {
		"id": {
			"description": "Unique across the layout. Used in CSS class names (.spf-n-<id>).",
			"type": "string",
			"pattern": "^[A-Za-z0-9_-]{1,64}$"
		},
		"label": { "type": "string", "maxLength": 200 },
		"props": {
			"description": "Styling and visibility. All keys are optional.",
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"label": { "$ref": "#/$defs/label" },
				"fontSize": { "type": "number", "minimum": 6, "maximum": 72, "description": "px" },
				"bold": { "type": "boolean" },
				"align": { "enum": ["left", "center", "right"] },
				"width": { "type": "number", "minimum": 1, "maximum": 100, "description": "% of the parent" },
				"color": {
					"type": "string",
					"pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[a-zA-Z]{3,20})$",
					"description": "Hex color (#1f2328). Plain CSS color names (red) are also accepted because the designer allows them."
				},
				"hidden": { "type": "boolean" },
				"hideLabel": { "type": "boolean" },
				"condition": {
					"type": "string",
					"maxLength": 500,
					"description": "Print only when true, e.g. doc.customer != ''. Stored without 'eval:' (accepted with it too)."
				},
				"columns": {
					"description": "Table fields only: the child-table columns to print, in order. Without it, the child DocType's 'In List View' fields. Widths may add up to 100 at most.",
					"type": "array",
					"maxItems": 30,
					"items": { "$ref": "#/$defs/tableColumn" }
				},
				"showHeader": { "type": "boolean", "description": "Table fields only: print the header row (default true)." },
				"showTotal": { "type": "boolean", "description": "Table fields only: print a total row under the table (default false)." },
				"totalField": {
					"type": "string",
					"pattern": "^[A-Za-z_][A-Za-z0-9_]{0,139}$",
					"description": "Table fields only: the parent field shown in the total row, e.g. grand_total."
				}
			}
		},
		"tableColumn": {
			"type": "object",
			"required": ["fieldname"],
			"additionalProperties": false,
			"properties": {
				"fieldname": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,139}$" },
				"label": { "$ref": "#/$defs/label" },
				"width": { "type": "number", "minimum": 1, "maximum": 100, "description": "% of the table width" }
			}
		},
		"section": {
			"type": "object",
			"required": ["id", "type", "columns"],
			"additionalProperties": false,
			"properties": {
				"id": { "$ref": "#/$defs/id" },
				"type": { "const": "section" },
				"kind": { "enum": ["header", "footer"], "description": "Absent for body sections. Header must be first, footer last." },
				"label": { "$ref": "#/$defs/label" },
				"props": { "$ref": "#/$defs/props" },
				"columns": {
					"type": "array",
					"minItems": 1,
					"maxItems": 12,
					"items": { "$ref": "#/$defs/column" }
				}
			}
		},
		"column": {
			"type": "object",
			"required": ["id", "type", "fields"],
			"additionalProperties": false,
			"properties": {
				"id": { "$ref": "#/$defs/id" },
				"type": { "const": "column" },
				"props": { "$ref": "#/$defs/props" },
				"fields": {
					"type": "array",
					"maxItems": 200,
					"items": {
						"discriminator": "type",
						"oneOf": [{ "$ref": "#/$defs/field" }, { "$ref": "#/$defs/component" }]
					}
				}
			}
		},
		"fieldname": {
			"description": "A field of the target DocType, or table.child_field for a child table's first row.",
			"type": "string",
			"pattern": "^[A-Za-z_][A-Za-z0-9_]{0,139}(\\.[A-Za-z_][A-Za-z0-9_]{0,139})?$"
		},
		"field": {
			"type": "object",
			"required": ["id", "type", "fieldname"],
			"additionalProperties": false,
			"properties": {
				"id": { "$ref": "#/$defs/id" },
				"type": { "const": "field" },
				"fieldname": { "$ref": "#/$defs/fieldname" },
				"label": { "$ref": "#/$defs/label" },
				"fieldtype": { "type": "string", "maxLength": 40 },
				"options": { "type": "string", "maxLength": 1000, "description": "For a Table field: the child DocType." },
				"props": { "$ref": "#/$defs/props" },
				"table": {
					"description": "Legacy form of props.columns (still accepted; props.columns wins).",
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"columns": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/tableColumn" } }
					}
				}
			}
		},
		"component": {
			"type": "object",
			"required": ["id", "type", "component"],
			"additionalProperties": false,
			"properties": {
				"id": { "$ref": "#/$defs/id" },
				"type": { "const": "component" },
				"component": { "type": "string", "minLength": 1, "maxLength": 140, "description": "Smart Print Format Component name." },
				"component_name": { "type": "string", "maxLength": 140 },
				"component_type": { "type": "string", "maxLength": 140, "description": "Informational; the server uses the component's stored type." },
				"configuration": { "type": "object", "description": "Overrides for the component's configuration_json." },
				"props": { "$ref": "#/$defs/props" }
			}
		}
	}
}
